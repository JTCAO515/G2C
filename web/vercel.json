{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "p=\"$VERCEL_GIT_PREVIOUS_SHA\"; if git cat-file -e \"$p^{commit}\"; then git diff --quiet \"$p\" HEAD -- .; elif [ \"$VERCEL_ENV\" = production ]; then git diff --quiet HEAD^ HEAD -- .; else exit 1; fi",
  "regions": ["hkg1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
