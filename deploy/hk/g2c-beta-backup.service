[Unit]
Description=G2C synthetic beta checkpoint to private Hong Kong OSS
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/g2c-beta
UMask=0077
ExecStart=/bin/sh /srv/g2c-beta/deploy/hk/daily-backup.sh
# Runs only after a successful ExecStart (Type=oneshot); ops_alerts check reads it (#1720).
ExecStartPost=/usr/bin/python3 -B /srv/g2c-beta/deploy/hk/ops_alerts.py backup-succeeded
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
