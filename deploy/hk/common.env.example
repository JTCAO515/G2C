CJ_ENV=local
CJ_DEPLOY_TARGET=hk-beta
CJ_M4_SYNTHETIC_ONLY=1
CJ_TRIAL_VALID_UNTIL=REPLACE_WITH_VERIFIED_TRIAL_EXPIRY_ISO8601
CJ_SUPABASE_CA_FILE=/run/config/supabase-ca.crt
CJ_DEPLOY_CONTROL=/control
CJ_DEPLOY_HEARTBEAT=/heartbeat
CJ_BETA_SUBJECTS_JSON=["m4-synthetic-beta-a","m4-synthetic-beta-b"]
CJ_BETA_SIGNING_PUBLIC_B64=REPLACE_WITH_PUBLIC_RSA_PEM_BASE64
CJ_BETA_RECOVERY_PUBLIC_B64=REPLACE_WITH_ED25519_PUBLIC_32_BYTES_BASE64
CJ_BETA_RUN_CONTEXT_JSON=REPLACE_WITH_EXPLICIT_CJ_LOCAL_RUN_2_JSON
# Optional existing manual NEEDS API; absent keeps it disabled.
# CJ_LOCAL_NEEDS_PROFILE=manual-v1
