{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go2china.space/contracts/message/trip-schema.2.json",
  "title": "#860 additive Lio calendar/selection contracts; no new core MESSAGE send version",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "DayIndex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "Date": {
      "type": "string",
      "format": "date"
    },
    "Check": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "weather",
            "day_opening"
          ]
        },
        "state": {
          "enum": [
            "not_checked",
            "unknown",
            "clear",
            "conflict"
          ]
        },
        "day_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DayIndex"
          }
        },
        "item_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "required": [
        "kind",
        "state",
        "day_indices",
        "item_ids",
        "reason",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "UndatedSelection": {
      "type": "object",
      "properties": {
        "day_index": {
          "$ref": "#/$defs/DayIndex"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "enum": [
              "localtime",
              "Factory"
            ]
          }
        }
      },
      "required": [
        "day_index"
      ],
      "additionalProperties": false
    },
    "DatedSelection": {
      "type": "object",
      "properties": {
        "date": {
          "$ref": "#/$defs/Date"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "enum": [
              "localtime",
              "Factory"
            ]
          }
        }
      },
      "required": [
        "date",
        "timezone"
      ],
      "additionalProperties": false
    },
    "DaySelection": {
      "oneOf": [
        {
          "$ref": "#/$defs/UndatedSelection"
        },
        {
          "$ref": "#/$defs/DatedSelection"
        }
      ]
    },
    "TripSelection2": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "day": {
          "anyOf": [
            {
              "$ref": "#/$defs/DaySelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "expected_version",
        "day",
        "item_id"
      ],
      "additionalProperties": false
    },
    "CanonicalMessageReference": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "message_version": {
          "enum": [
            "MESSAGE-send.1",
            "MESSAGE-send.2",
            "MESSAGE-send.3",
            "MESSAGE-send.4"
          ]
        },
        "lio_protocol": {
          "enum": [
            "LIO-message.1",
            "LIO-message.2",
            "LIO-message.3"
          ]
        }
      },
      "required": [
        "conversation_id",
        "generation",
        "message_id",
        "run_id",
        "sequence",
        "input_sha256",
        "message_version",
        "lio_protocol"
      ],
      "additionalProperties": false
    },
    "TripReference": {
      "type": "object",
      "properties": {
        "version": {
          "const": "LIO-trip-reference.1"
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "message_version": {
          "enum": [
            "MESSAGE-send.1",
            "MESSAGE-send.2",
            "MESSAGE-send.3",
            "MESSAGE-send.4"
          ]
        },
        "lio_protocol": {
          "enum": [
            "LIO-message.1",
            "LIO-message.2",
            "LIO-message.3"
          ]
        },
        "trip_id": {
          "$ref": "#/$defs/Id"
        },
        "trip_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "content_version": {
          "enum": [
            "structured.1",
            "structured.2",
            "structured.3"
          ]
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selection": {
          "$ref": "#/$defs/TripSelection2"
        }
      },
      "required": [
        "version",
        "conversation_id",
        "generation",
        "message_id",
        "run_id",
        "sequence",
        "input_sha256",
        "message_version",
        "lio_protocol",
        "trip_id",
        "trip_version",
        "content_version",
        "content_sha256",
        "selection"
      ],
      "additionalProperties": false
    },
    "LioMessage3": {
      "type": "object",
      "properties": {
        "version": {
          "const": "LIO-message.3"
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "locale": {
          "enum": [
            "zh",
            "en"
          ]
        },
        "conversation_id": {
          "type": "string",
          "pattern": "^lio-dialogue-[0-9a-f]{32}$"
        },
        "new_conversation": {
          "const": true
        }
      },
      "required": [
        "version",
        "message_id",
        "text",
        "locale"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "conversation_id",
          "new_conversation"
        ]
      }
    },
    "LioReceipt3": {
      "type": "object",
      "properties": {
        "version": {
          "const": "LIO-message-receipt.3"
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "conversation_id": {
          "type": "string",
          "pattern": "^lio-dialogue-[0-9a-f]{32}$"
        }
      },
      "required": [
        "version",
        "message_id",
        "conversation_id"
      ],
      "additionalProperties": false
    },
    "LioLookup3": {
      "type": "object",
      "properties": {
        "version": {
          "const": "LIO-message-lookup.3"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/LioReceipt3"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "receipt"
      ],
      "additionalProperties": false
    },
    "CardItem": {
      "type": "object",
      "properties": {
        "item_id": {
          "$ref": "#/$defs/Id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "start_time": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9])?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_time": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9])?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "item_id",
        "label",
        "start_time",
        "end_time",
        "fixed"
      ],
      "additionalProperties": false
    },
    "UndatedCardDay": {
      "type": "object",
      "properties": {
        "day_index": {
          "$ref": "#/$defs/DayIndex"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardItem"
          },
          "maxItems": 60
        }
      },
      "required": [
        "day_index",
        "items"
      ],
      "additionalProperties": false
    },
    "DatedCardDay": {
      "type": "object",
      "properties": {
        "day_index": {
          "$ref": "#/$defs/DayIndex"
        },
        "date": {
          "$ref": "#/$defs/Date"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardItem"
          },
          "maxItems": 60
        }
      },
      "required": [
        "day_index",
        "date",
        "items"
      ],
      "additionalProperties": false
    },
    "LegacyCardDay": {
      "type": "object",
      "properties": {
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CardItem"
          },
          "maxItems": 60
        }
      },
      "required": [
        "date",
        "items"
      ],
      "additionalProperties": false
    },
    "Card2": {
      "type": "object",
      "properties": {
        "version": {
          "const": "LIO-trip-card.2"
        },
        "trip_id": {
          "$ref": "#/$defs/Id"
        },
        "trip_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "content_version": {
          "enum": [
            "structured.1",
            "structured.2",
            "structured.3"
          ]
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "calendar": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "const": "undated"
                    }
                  },
                  "required": [
                    "state"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "const": "dated"
                    },
                    "start_date": {
                      "$ref": "#/$defs/Date"
                    }
                  },
                  "required": [
                    "state",
                    "start_date"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "days": {
          "type": "array",
          "items": {},
          "minItems": 1
        },
        "date_checks": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Check"
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "trip_id",
        "trip_version",
        "content_version",
        "content_sha256",
        "title",
        "calendar",
        "days",
        "date_checks"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "content_version": {
                "const": "structured.3"
              }
            }
          },
          "then": {
            "properties": {
              "calendar": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "const": "undated"
                      }
                    },
                    "required": [
                      "state"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "const": "dated"
                      },
                      "start_date": {
                        "$ref": "#/$defs/Date"
                      }
                    },
                    "required": [
                      "state",
                      "start_date"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "date_checks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Check"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "calendar": {
                      "properties": {
                        "state": {
                          "const": "undated"
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "days": {
                      "items": {
                        "$ref": "#/$defs/UndatedCardDay"
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "days": {
                      "items": {
                        "$ref": "#/$defs/DatedCardDay"
                      }
                    }
                  }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "calendar": {
                "type": "null"
              },
              "date_checks": {
                "type": "null"
              },
              "days": {
                "items": {
                  "$ref": "#/$defs/LegacyCardDay"
                }
              }
            }
          }
        }
      ]
    },
    "Citation": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "url",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "MemoryTag": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "fact",
            "preference"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "target"
      ],
      "additionalProperties": false
    },
    "TimelineMessage3": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "status": {
          "enum": [
            "sending",
            "answering",
            "completed",
            "failed"
          ]
        },
        "failure": {
          "enum": [
            null,
            "quota",
            "unavailable"
          ]
        },
        "activity": {
          "enum": [
            null,
            "checking_places",
            "checking_weather",
            "checking_travel_information"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Citation"
          }
        },
        "trip": {
          "anyOf": [
            {
              "$ref": "#/$defs/Card2"
            },
            {
              "type": "null"
            }
          ]
        },
        "memory": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "tags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/MemoryTag"
                  },
                  "minItems": 1,
                  "maxItems": 50
                }
              },
              "required": [
                "tags"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "message_id",
        "text",
        "answer",
        "status",
        "failure",
        "activity",
        "sources",
        "trip",
        "memory"
      ],
      "additionalProperties": false
    },
    "Timeline3": {
      "type": "object",
      "properties": {
        "version": {
          "const": "LIO-timeline.3"
        },
        "conversation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^lio-dialogue-[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimelineMessage3"
          }
        },
        "next_before": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "conversation_id",
        "messages",
        "next_before"
      ],
      "additionalProperties": false
    },
    "History3": {
      "type": "object",
      "properties": {
        "version": {
          "const": "LIO-trip-history.3"
        },
        "conversation_id": {
          "type": "string",
          "pattern": "^lio-dialogue-[0-9a-f]{32}$"
        },
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/Card2"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Card2"
          }
        },
        "undo_target": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "next_before": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "conversation_id",
        "current",
        "history",
        "undo_target",
        "next_before"
      ],
      "additionalProperties": false
    },
    "Undo3": {
      "type": "object",
      "properties": {
        "version": {
          "const": "LIO-trip-undo.3"
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "conversation_id": {
          "type": "string",
          "pattern": "^lio-dialogue-[0-9a-f]{32}$"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,512}$"
        }
      },
      "required": [
        "version",
        "action_id",
        "conversation_id",
        "target"
      ],
      "additionalProperties": false
    },
    "UndoReceipt3": {
      "type": "object",
      "properties": {
        "version": {
          "const": "LIO-trip-undo-receipt.3"
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "conversation_id": {
          "type": "string",
          "pattern": "^lio-dialogue-[0-9a-f]{32}$"
        },
        "committed": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "action_id",
        "conversation_id",
        "committed"
      ],
      "additionalProperties": false
    },
    "DateSource": {
      "type": "object",
      "properties": {
        "reference": {
          "$ref": "#/$defs/CanonicalMessageReference"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "question_day": {
          "$ref": "#/$defs/Date"
        }
      },
      "required": [
        "reference",
        "quote",
        "question_day"
      ],
      "additionalProperties": false
    },
    "DateConvert": {
      "type": "object",
      "properties": {
        "version": {
          "const": "TRIP-date-convert.1"
        },
        "action_id": {
          "$ref": "#/$defs/Id"
        },
        "trip_id": {
          "$ref": "#/$defs/Id"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "original_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "start_date": {
          "$ref": "#/$defs/Date"
        },
        "date_source": {
          "$ref": "#/$defs/DateSource"
        }
      },
      "required": [
        "version",
        "action_id",
        "trip_id",
        "expected_version",
        "original_hash",
        "start_date",
        "date_source"
      ],
      "additionalProperties": false
    },
    "Conflict": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "hard_fixed",
            "date_dependent"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "day_indices": {
          "type": "array",
          "items": {
