{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go2china.space/contracts/message/lio-answer-rich-schema.1.json",
  "title": "LIO-answer-rich.1 — the `rich` object on a LIO-timeline.2 row (#1984)",
  "description": "Synthetic shapes only. Rows of a poll that declared accepts=LIO-answer-rich.1 may carry `rich` next to `layout` and `followups` (LIO-answer-followups.1, unchanged). Offsets, order, uniqueness, sizes and the undo derivation are checked by check_lio_answer_rich.py.",
  "$ref": "#/$defs/rich",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "City": {
      "type": "object",
      "required": [
        "id",
        "zh",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{3,20}$"
        },
        "zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
        }
      }
    },
    "rich": {
      "type": "object",
      "required": [
        "version"
      ],
      "minProperties": 2,
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "LIO-answer-rich.1"
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "trip_receipt": {
          "$ref": "#/$defs/trip_receipt"
        },
        "memory": {
          "$ref": "#/$defs/memory"
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "type",
        "start",
        "end",
        "place_id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "place"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 199998
        },
        "end": {
          "type": "integer",
          "minimum": 2,
          "maximum": 200000
        },
        "place_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^pl_[a-z]{2}_[a-z0-9]+(_[a-z0-9]+)*$"
        }
      }
    },
    "card": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "label",
            "open"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "taxi"
            },
            "label": {
              "enum": [
                "打车去这里",
                "Taxi there"
              ]
            },
            "open": {
              "type": "object",
              "required": [
                "tool",
                "parameters"
              ],
              "additionalProperties": false,
              "properties": {
                "tool": {
                  "const": "taxi"
                },
                "parameters": {
                  "type": "object",
                  "required": [
                    "destination",
                    "lat",
                    "lng"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "destination": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                    },
                    "lat": {
                      "type": "string",
                      "pattern": "^-?[0-9]{1,2}(\\.[0-9]{1,6})?$"
                    },
                    "lng": {
                      "type": "string",
                      "pattern": "^-?[0-9]{1,3}(\\.[0-9]{1,6})?$"
                    },
                    "address": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                    },
                    "destinationEN": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "label",
            "open",
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "metro"
            },
            "label": {
              "enum": [
                "看地铁线路",
                "Metro map"
              ]
            },
            "open": {
              "type": "object",
              "required": [
                "tool",
                "parameters"
              ],
              "additionalProperties": false,
              "properties": {
                "tool": {
                  "const": "metro-guide"
                },
                "parameters": {
                  "type": "object",
                  "maxProperties": 0,
                  "additionalProperties": false
                }
              }
            },
            "data": {
              "type": "object",
              "required": [
                "city"
              ],
              "additionalProperties": false,
              "properties": {
                "city": {
                  "type": "object",
                  "required": [
                    "id",
                    "zh",
                    "en"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z]{3,20}$"
                    },
                    "zh": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12,
                      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 24,
                      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                    }
                  }
                },
                "route": {
                  "type": "object",
                  "required": [
                    "from",
                    "to",
                    "lines"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "from": {
                      "type": "object",
                      "required": [
                        "zh"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "zh": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40,
                          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                        },
                        "en": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40,
                          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                        }
                      }
                    },
                    "to": {
                      "type": "object",
                      "required": [
                        "zh"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "zh": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40,
                          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                        },
                        "en": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40,
                          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                        }
                      }
                    },
                    "lines": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "required": [
                          "zh"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "zh": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40,
                            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                          },
                          "en": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40,
                            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "label",
            "open",
            "data"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "transport"
            },
            "label": {
              "enum": [
                "查火车和航班",
                "Trains & flights"
              ]
            },
            "open": {
              "type": "object",
              "required": [
                "tool",
                "parameters"
              ],
              "additionalProperties": false,
              "properties": {
                "tool": {
                  "const": "transport"
                },
                "parameters": {
                  "type": "object",
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "from": {
                      "type": "string",
                      "pattern": "^[a-z]{3,20}$"
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^[a-z]{3,20}$"
                    }
                  }
                }
              }
            },
            "data": {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "object",
                  "required": [
                    "id",
                    "zh",
                    "en"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z]{3,20}$"
                    },
                    "zh": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12,
                      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 24,
                      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                    }
                  }
                },
                "to": {
                  "type": "object",
                  "required": [
                    "id",
                    "zh",
                    "en"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z]{3,20}$"
                    },
                    "zh": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12,
                      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 24,
                      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "label",
            "open"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "currency"
            },
            "label": {
              "enum": [
                "汇率换算",
                "Convert currency"
              ]
            },
            "open": {
              "type": "object",
              "required": [
                "tool",
                "parameters"
              ],
              "additionalProperties": false,
              "properties": {
                "tool": {
                  "const": "currency"
                },
                "parameters": {
                  "type": "object",
                  "maxProperties": 0,
                  "additionalProperties": false
                }
              }
            },
            "data": {
              "type": "object",
              "required": [
                "quote"
              ],
              "additionalProperties": false,
              "dependentRequired": {
                "cny_per_unit": [
                  "as_of"
                ],
                "as_of": [
                  "cny_per_unit"
                ]
              },
              "properties": {
                "quote": {
                  "enum": [
                    "USD",
                    "EUR",
                    "GBP",
                    "JPY",
                    "KRW",
                    "HKD",
                    "AUD",
                    "CAD",
                    "SGD",
                    "THB"
                  ]
                },
                "cny_per_unit": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,3})(\\.[0-9]{1,6})?$"
                },
                "as_of": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                }
              }
            }
          }
        }
      ]
    },
    "trip_receipt": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "action_id",
            "trip_id",
            "committed_version",
            "undo"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "saved"
            },
            "action_id": {
              "$ref": "#/$defs/Id"
            },
            "trip_id": {
              "$ref": "#/$defs/Id"
            },
            "committed_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775806
            },
            "first_autosave": {
              "const": true
            },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "days",
                "wishlist_added",
                "legs_updated"
              ],
              "properties": {
                "days": {
                  "type": "array",
                  "maxItems": 14,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "day",
                      "city",
                      "added",
                      "updated",
                      "removed"
                    ],
                    "properties": {
                      "day": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 60
                      },
                      "city": {
                        "oneOf": [
                          {
                            "$ref": "#/$defs/City"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "added": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 99
                      },
                      "updated": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 99
                      },
                      "removed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 99
                      }
                    }
                  }
                },
                "wishlist_added": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99
                },
                "legs_updated": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99
                }
              }
            },
            "undo": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "state",
                    "action_id",
                    "until",
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "const": "available"
                    },
                    "kind": {
                      "const": "restore"
                    },
                    "action_id": {
                      "type": "string",
                      "pattern": "^undo-[0-9a-f]{40}$"
                    },
                    "until": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}\\+00:00$"
                    },
                    "target": {
                      "$ref": "https://go2china.space/contracts/message/lio-trip-history-schema.4.json#/$defs/UndoTarget"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "state",
                    "kind",
                    "action_id",
                    "until",
                    "target"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "const": "available"
                    },
                    "kind": {
                      "const": "withdraw_created"
                    },
                    "action_id": {
                      "type": "string",
                      "pattern": "^undo-[0-9a-f]{40}$"
                    },
                    "until": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}\\+00:00$"
                    },
                    "target": {
                      "type": "object",
                      "required": [
                        "trip_id",
                        "expected_version",
                        "original_hash",
                        "content_version"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "trip_id": {
                          "$ref": "#/$defs/Id"
                        },
                        "expected_version": {
                          "const": 1
                        },
                        "original_hash": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "content_version": {
                          "enum": [
                            "structured.1",
                            "structured.2",
                            "structured.3",
                            "structured.4"
                          ]
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "state",
                    "until"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "enum": [
                        "expired",
                        "superseded",
                        "undone"
                      ]
                    },
                    "until": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}\\+00:00$"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "state"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "const": "unavailable"
                    },
                    "until": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}\\+00:00$"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "action_id"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "not_saved"
            },
            "action_id": {
              "$ref": "#/$defs/Id"
            },
            "reason": {
              "enum": [
                "conflict",
                "protected",
                "too_large"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "action_id"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "unknown"
            },
            "action_id": {
              "$ref": "#/$defs/Id"
            }
          }
        }
      ]
    },
    "memory": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "dependentRequired": {
        "used": [
          "used_total"
        ],
        "used_total": [
          "used"
        ]
      },
      "properties": {
        "prompt": {
          "const": "consent"
        },
        "used": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "item_id",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\ufeff]+$"
              }
            }
          }
        },
        "used_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    }
  }
}
