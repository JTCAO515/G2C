  "components": {
    "schemas": {
      "ConversationSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conversation_id",
          "generation",
          "epoch",
          "list_sequence"
        ],
        "properties": {
          "conversation_id": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "string",
            "minLength": 1
          },
          "epoch": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "list_sequence": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "MessageHistoryItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt",
          "original_utf8_base64",
          "text"
        ],
        "properties": {
          "receipt": {
            "$ref": "#/components/schemas/MessageReceipt"
          },
          "original_utf8_base64": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
            "description": "RFC4648 base64 exact original UTF8 bytes, no text reconstruction; empty draft bytes encode as empty string."
          },
          "text": {
            "type": "string"
          }
        }
      },
      "MessageDraftSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conversation_id",
          "generation",
          "revision",
          "original_utf8_base64"
        ],
        "properties": {
          "conversation_id": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "original_utf8_base64": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
            "description": "RFC4648 base64 exact original UTF8 bytes, no text reconstruction; empty draft bytes encode as empty string."
          }
        }
      },
      "ConversationPageResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "conversations",
          "next_cursor"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "conversations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConversationSummary"
            }
          },
          "next_cursor": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "enum": [
                  null
                ]
              }
            ]
          }
        }
      },
      "MessageHistoryResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "messages",
          "next_cursor"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageHistoryItem"
            }
          },
          "next_cursor": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "enum": [
                  null
                ]
              }
            ]
          }
        }
      },
      "MessageDraftReadResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "draft"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "draft": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/MessageDraftSnapshot"
              },
              {
                "enum": [
                  null
                ]
              }
            ]
          }
        }
      },
      "MessageDraftSaveResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "draft"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "draft": {
            "$ref": "#/components/schemas/MessageDraftSnapshot"
          }
        }
