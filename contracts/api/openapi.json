  "components": {
    "schemas": {
      "RequestId": {
        "type": "string",
        "format": "uuid",
        "description": "Server-generated per HTTP attempt; never an idempotency or authorization token."
      },
      "ProbeResponse": {
        "type": "object",
        "required": [
          "contract_version",
          "status",
          "request_id"
        ],
        "properties": {
          "contract_version": {
            "type": "string",
            "enum": [
              "1.0.0"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "ErrorInfo": {
        "type": "object",
        "required": [
          "code",
          "category",
          "message_en",
          "message_zh",
          "outcome",
          "recovery"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "message_en": {
            "type": "string"
          },
          "message_zh": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "failed",
              "unknown",
              "partial"
            ]
          },
          "recovery": {
            "type": "string",
            "enum": [
              "do_not_retry",
              "retry_safe_read",
              "reconcile_original"
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "request_id",
          "error"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          }
        }
      },
      "MessageReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message_id",
          "conversation_id",
          "generation",
          "sequence",
          "run_id",
          "input_sha256"
        ],
        "properties": {
          "message_id": {
            "type": "string",
            "minLength": 1
          },
          "conversation_id": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "MessageReceiveResponse": {
        "type": "object",
        "required": [
          "request_id",
          "receipt"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "receipt": {
            "$ref": "#/components/schemas/MessageReceipt"
          }
        }
      },
      "MessageReceiptQueryResponse": {
        "type": "object",
        "required": [
          "request_id",
          "receipt"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "receipt": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/MessageReceipt"
              },
              {
                "enum": [
                  null
                ]
              }
            ],
            "description": "Required property: committed receipt or explicit null (not observed); absence is invalid. Generated fallback containers must be checked for actual null, never treated as null by case alone."
          }
        }
      },
      "ConversationSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conversation_id",
          "generation",
          "epoch",
          "list_sequence"
        ],
        "properties": {
          "conversation_id": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "string",
            "minLength": 1
          },
          "epoch": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "list_sequence": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9223372036854775807
          }
        }
      },
      "MessageHistoryItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt",
          "original_utf8_base64",
          "text"
        ],
        "properties": {
          "receipt": {
            "$ref": "#/components/schemas/MessageReceipt"
          },
          "original_utf8_base64": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
            "description": "RFC4648 base64 exact original UTF8 bytes, no text reconstruction; empty draft bytes encode as empty string."
          },
          "text": {
            "type": "string"
          }
        }
      },
      "MessageDraftSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conversation_id",
          "generation",
          "revision",
          "original_utf8_base64"
        ],
        "properties": {
          "conversation_id": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "string",
            "minLength": 1
          },
