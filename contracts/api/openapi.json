        ],
        "responses": {
          "200": {
            "description": "Authorized MEMORY wire candidate response; no production channel enabled.",
            "headers": {
              "X-Request-ID": {
                "required": true,
                "schema": {
                  "$ref": "#/components/schemas/RequestId"
                }
              }
            },
