{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go2china.space/contracts/trip/structured-read-schema.3.json",
  "title": "Rich protected read data contract; old content retained verbatim",
  "$defs": {
    "Summary": {
      "type": "object",
      "properties": {
        "trip_id": {
          "$ref": "https://go2china.space/contracts/trip/structured-read-schema.2.json#/$defs/Id"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "content_version": {
          "enum": [
            "structured.1",
            "structured.2",
            "structured.3",
            "structured.4"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "calendar": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "const": "undated"
                    }
                  },
                  "required": [
                    "state"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "const": "dated"
                    },
                    "start_date": {
                      "$ref": "https://go2china.space/contracts/trip/structured-read-schema.2.json#/$defs/Date"
                    }
                  },
                  "required": [
                    "state",
                    "start_date"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "day_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "trip_id",
        "version",
        "content_version",
        "title",
        "content_sha256",
        "calendar",
        "day_count"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "content_version": {
                "enum": [
                  "structured.3",
                  "structured.4"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "calendar": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "const": "undated"
                      }
                    },
                    "required": [
                      "state"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "state": {
                        "const": "dated"
                      },
                      "start_date": {
                        "$ref": "https://go2china.space/contracts/trip/structured-read-schema.2.json#/$defs/Date"
                      }
                    },
                    "required": [
                      "state",
                      "start_date"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "day_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              }
            }
          },
          "else": {
            "properties": {
              "calendar": {
                "type": "null"
              },
              "day_count": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "TripRecord": {
      "type": "object",
      "properties": {
        "trip_id": {
          "$ref": "https://go2china.space/contracts/trip/structured-read-schema.2.json#/$defs/Id"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content": {
          "oneOf": [
            {
              "$ref": "https://go2china.space/contracts/trip/structured-read-schema.2.json#/$defs/LegacyContent"
            },
            {
              "$ref": "https://go2china.space/contracts/trip/structured-read-schema.2.json#/$defs/ContentV3"
            },
            {
              "$ref": "https://go2china.space/contracts/trip/structured-schema.4.json"
            }
          ]
        }
      },
      "required": [
        "trip_id",
        "version",
        "content_sha256",
        "content"
      ],
      "additionalProperties": false
    },
    "List": {
      "type": "object",
      "properties": {
        "version": {
          "const": "TRIP-structured-read.3"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "trips": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Summary"
          }
        },
        "next_after": {
          "anyOf": [
            {
              "$ref": "https://go2china.space/contracts/trip/structured-read-schema.2.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "request_id",
        "trips",
        "next_after"
      ],
      "additionalProperties": false
    },
    "Detail": {
      "type": "object",
      "properties": {
        "version": {
          "const": "TRIP-structured-read.3"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "trip": {
          "anyOf": [
            {
              "$ref": "#/$defs/TripRecord"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "request_id",
        "trip"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/List"
    },
    {
      "$ref": "#/$defs/Detail"
    }
  ]
}
